#!/usr/bin/env sh
# see this wiki page for information:
#  - https://github.com/koekeishiya/yabai/wiki/Installing-yabai-(latest-release)
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# current config modified from
# https://cbrgm.net/post/2021-05-5-setup-macos/
function setup_space {
  local idx="$1"
  local name="$2"
  local space=
  echo "setup space $idx : $name"

  space=$(yabai -m query --spaces --space "$idx")
  if [ -z "$space" ]; then
    yabai -m space --create
  fi

  yabai -m space "$idx" --label "$name"
}

setup_space 1 web
setup_space 2 code
setup_space 3 music
setup_space 4 communication
yabai -m config --space 4 layout stack
setup_space 5 personal
setup_space 6 misc
yabai -m config --space 6 layout float
setup_space 7 games
yabai -m config --space 7 layout float
setup_space 8 stream
yabai -m config --space 8 layout float


# bar settings
yabai -m config top_padding 0

# global settings
yabai -m config mouse_follows_focus          off
yabai -m config focus_follows_mouse          off

yabai -m config window_placement             second_child

yabai -m config window_opacity               off
yabai -m config window_opacity_duration      0.0
yabai -m config window_shadow                on

yabai -m config active_window_opacity        1.0
yabai -m config normal_window_opacity        0.90
yabai -m config split_ratio                  0.50
yabai -m config auto_balance                 off

# Mouse support
yabai -m config mouse_modifier               alt
yabai -m config mouse_action1                move
yabai -m config mouse_action2                resize

# general space settings
yabai -m config top_padding                  10
yabai -m config bottom_padding               10
yabai -m config left_padding                 10
yabai -m config right_padding                10
yabai -m config window_gap                   10

# float system preferences
yabai -m rule --add app='^System Information$' manage=off
yabai -m rule --add app='^Microsoft Teams$' manage=off
yabai -m rule --add app='^System Preferences$' manage=off
yabai -m rule --add app='^System Settings$' manage=off
yabai -m rule --add title='Preferences$' manage=off

# float certain applications
yabai -m rule --add app='^Cisco' manage=off
yabai -m rule --add app="^Bitwarden$" sticky=on manage=off
yabai -m rule --add app='^Loom$' manage=off
yabai -m rule --add app='^Supercut$' manage=off

# Web browsers
yabai -m rule --add app="^(Firefox|Zen)$" space=^1
yabai -m rule --add app="^(Wezterm|WezTerm|Terminal|Ghostty|Alacritty)$" space=^2
yabai -m rule --add app="^(Google Chrome|Chrome|Chromium|Safari)$" space=^3
yabai -m rule --add app="^(Slack|Signal|Messages|Messenger|Mail|Teams|Microsoft Teams|Zoom)$" space=^4
yabai -m rule --add app="^(Notes|Reminders|Calendar)$" space=^5
yabai -m rule --add app="^(Spotify|Music|Apple Music)$" space=^6
yabai -m rule --add app="^(Discord|Battle.net|World of Warcraft|Hearthstone|Riot Client|League of Legends|League of Legends (TM) Client)$" space=^7



echo "yabai configuration loaded.."
